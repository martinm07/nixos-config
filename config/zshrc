# Lines configured by zsh-newuser-install
HISTFILE=~/.local/state/zshhist
HISTSIZE=1001
SAVEHIST=1000
setopt autocd extendedglob nomatch notify
unsetopt beep
bindkey -v
# End of lines configured by zsh-newuser-install
# The following lines were added by compinstall
zstyle :compinstall filename '/home/martinm/.zshrc'

autoload -Uz compinit
# https://blog.smittytone.net/2021/04/03/how-to-use-zmv-z-shell-super-smart-file-renamer/
# https://www.linuxjournal.com/content/bash-extended-globbing
autoload zmv
compinit
# End of lines added by compinstall

if [[ -n "$IN_NIX_SHELL" ]]; then
  NIX_PATH_COLOR="#5fc10f"
else
  NIX_PATH_COLOR="#e2f9e0"
fi

PS1="%F{#e2f9e0}[%* - %F{#6a7569}%D%F{#e2f9e0}] %B%F{$NIX_PATH_COLOR}%~%b %% %f"

export PATH="$HOME/.local/bin:$PATH"

alias nix-shell='nix-shell --command "exec zsh"'
